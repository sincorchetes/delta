<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sincorchetes.Delta</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Delta</name>
  <summary>Time travel for your files</summary>
  <developer id="tech.sincorchetes">
    <name>Álvaro Castillo</name>
  </developer>

  <description>
    <p>Delta keeps backups of your files, one after another, and lets you look at any of them. Restore a document you changed by mistake, get back a folder you deleted, or browse an old backup as if it were a folder.</p>
    <p>Backups are made automatically, are encrypted and stay on this computer, in a folder or on a connected drive. Delta never sends them anywhere.</p>
    <ul>
      <li>Restore an earlier version from the file manager, with a preview, without overwriting anything</li>
      <li>See what changed or was deleted since a version, and put it all back</li>
      <li>Open a whole backup as a read-only folder</li>
      <li>Incremental and deduplicated backups, made by BorgBackup</li>
    </ul>
  </description>

  <categories>
    <category>Utility</category>
  </categories>

  <launchable type="desktop-id">io.github.sincorchetes.Delta.desktop</launchable>
  <icon type="stock">io.github.sincorchetes.Delta</icon>

  <url type="homepage">https://delta.sincorchetes.tech</url>
  <url type="help">https://delta.sincorchetes.tech</url>
  <url type="bugtracker">https://github.com/sincorchetes/delta/issues</url>
  <url type="vcs-browser">https://github.com/sincorchetes/delta</url>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/sincorchetes/delta/main/website/src/assets/screenshots/status-en-light.png</image>
      <caption>The main window says whether your files are protected</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/sincorchetes/delta/main/website/src/assets/screenshots/versions-en-light.png</image>
      <caption>Previous versions of a file, with a preview</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/sincorchetes/delta/main/website/src/assets/screenshots/folder-en-light.png</image>
      <caption>What a folder held, with what changed or was deleted</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <releases>
    <release version="0.5.2" date="2026-11-27">
      <description>
        <p>The daemon logs which repository it works on, and creating a repository clears the failure of the last backup.</p>
      </description>
    </release>
    <release version="0.5.1" date="2026-11-27">
      <description>
        <p>When the keyring has lost the passphrase of your backups, the window asks for it again.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-11-27">
      <description>
        <p>Right click on the empty space of your home folder offers «Restore Previous Version…». The cache of Flatpak apps is no longer backed up.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-11-25">
      <description>
        <p>New: «Check backups» in the main menu checks that your backups can be read, with progress and cancel.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-11-24">
      <description>
        <p>The window knows that your drive is gone without waiting for a backup, and a drive that fails or goes read-only while it is written to is told for what it is.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-20">
      <description>
        <p>Delta notices when another repository is in the place of your backups, and does not write in it.</p>
      </description>
    </release>
    <release version="0.1.3" date="2026-11-20">
      <description>
        <p>The daemon starts again on Fedora 43, Debian 13, Rocky Linux 10 and AlmaLinux 10. A drive that is not connected, is another one, is full or is read-only is told for what it is, and you can change where backups are kept.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-11-19">
      <description>
        <p>A backup folder inside the folders you back up is no longer copied into itself, and there is a module for NixOS.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-11-18">
      <description>
        <p>Packaging and documentation: a Flatpak bundle and the repositories for each distribution. No change to the program.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-18">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
