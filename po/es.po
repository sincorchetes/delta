#: data/io.github.sincorchetes.Delta.gschema.xml:6
msgid "Borg repository location"
msgstr "Ubicación del repositorio de Borg"

#: data/io.github.sincorchetes.Delta.gschema.xml:7
msgid "Local path of the Borg repository. Empty means not configured yet."
msgstr ""
"Ruta local del repositorio de Borg. Vacío significa que aún no está "
"configurado."

#: data/io.github.sincorchetes.Delta.gschema.xml:11 src/delta/ui/preferences_dialog.py:120
msgid "Folders to back up"
msgstr "Carpetas de las que hacer copia"

#: data/io.github.sincorchetes.Delta.gschema.xml:12
msgid ""
"Absolute paths of the folders to back up. Empty means the whole home folder."
msgstr ""
"Rutas absolutas de las carpetas de las que hacer copia. Vacío significa toda "
"la carpeta personal."

#: data/io.github.sincorchetes.Delta.gschema.xml:16
msgid "Files and folders to skip"
msgstr "Archivos y carpetas que omitir"

#: data/io.github.sincorchetes.Delta.gschema.xml:17
msgid ""
"Absolute paths that are not backed up, with everything inside them. Added to "
"the built-in exclusions (cache and trash)."
msgstr ""
"Rutas absolutas que no se copian, con todo lo que contienen. Se suman a las "
"exclusiones integradas (caché y papelera)."

#: data/io.github.sincorchetes.Delta.gschema.xml:21
msgid "Backup schedule"
msgstr "Programación de las copias"

#: data/io.github.sincorchetes.Delta.gschema.xml:22
msgid "systemd OnCalendar expression used by the delta.timer drop-in."
msgstr "Expresión OnCalendar de systemd usada por el drop-in de delta.timer."

#: data/io.github.sincorchetes.Delta.gschema.xml:26
msgid "Hourly snapshots to keep"
msgstr "Instantáneas horarias a conservar"

#: data/io.github.sincorchetes.Delta.gschema.xml:27
msgid "Retention policy passed to borg prune (--keep-hourly)."
msgstr "Política de retención pasada a borg prune (--keep-hourly)."

#: data/io.github.sincorchetes.Delta.gschema.xml:31
msgid "Daily snapshots to keep"
msgstr "Instantáneas diarias a conservar"

#: data/io.github.sincorchetes.Delta.gschema.xml:32
msgid "Retention policy passed to borg prune (--keep-daily)."
msgstr "Política de retención pasada a borg prune (--keep-daily)."

#: data/io.github.sincorchetes.Delta.gschema.xml:36
msgid "Weekly snapshots to keep"
msgstr "Instantáneas semanales a conservar"

#: data/io.github.sincorchetes.Delta.gschema.xml:37
msgid "Retention policy passed to borg prune (--keep-weekly)."
msgstr "Política de retención pasada a borg prune (--keep-weekly)."

#: data/io.github.sincorchetes.Delta.gschema.xml:41
msgid "Monthly snapshots to keep"
msgstr "Instantáneas mensuales a conservar"

#: data/io.github.sincorchetes.Delta.gschema.xml:42
